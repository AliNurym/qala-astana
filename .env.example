# === 1. OpenAI / Groq / OpenRouter (внешняя обработка — только после согласия) ===
OPENAI_API_KEY=
# Для OpenAI оставьте пустым, чтобы использовать настроенную модель по умолчанию.
# Для Groq, OpenRouter, Mistral, Ollama задайте поддерживаемый ими ID модели.
OPENAI_MODEL=
# Пример пользовательского адреса:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# === 2. Google Gemini API (проверьте актуальные лимиты и стоимость) ===
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# === 3. DeepSeek API (Альтернатива: https://platform.deepseek.com) ===
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# === 4. OpenRouteService (Опционально: https://openrouteservice.org/dev/#/signup) ===
ORS_API_KEY=
